# Copy these into Vercel → Project → Settings → Environment Variables.
# (Do NOT commit real keys. Locally you can use `vercel env pull` or a .env.local.)

# Required — the "what is it" brain (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional — turns on the auto price-band (developer.ebay.com → your app's Production keys)
# Leave blank to run ID + search-links only.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Which eBay market to price against. EBAY_GB (£) has the best vintage volume for Ireland.
EBAY_MARKETPLACE=EBAY_GB
