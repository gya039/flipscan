# Copy these into Vercel → Project → Settings → Environment Variables.
# (Do NOT commit real keys. Locally you can use `vercel env pull` or a .env.local.)

# REQUIRED — access code both you & Alex type once on the app (stops strangers
# spending your AI credit). Make it a decent random string.
FLIPSCAN_SECRET=change-me-to-something-random

# REQUIRED — the "what is it" brain (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# OPTIONAL — which platform the AI prices its estimate for (default: Vinted)
SELL_PLATFORM=Vinted

# OPTIONAL — turns on real eBay comps (developer.ebay.com → Production keys)
# Leave blank to run ID + AI estimate + search-links only.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Which eBay market to price against. EBAY_GB (£) has the best vintage volume.
EBAY_MARKETPLACE=EBAY_GB

# OPTIONAL — real SOLD prices, on demand via the "💷 Real sold price" button
# (SoldComps, sold-comps.com). Free plan = 100 lookups/month, so it's per-button,
# not per-scan. Key starts with sc_.
SOLDCOMPS_API_KEY=
# Which eBay site SoldComps searches (Ireland has no eBay site; .co.uk is closest).
SOLDCOMPS_SITE=ebay.co.uk

# OPTIONAL — the scan/purchase log + history page (Upstash Redis REST).
# From the Upstash console → your database → REST API section.
# ALSO powers the /api/img step that shop-search (SerpApi) needs — so if you want
# shop search, set these too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL — "Reverse image search the web" button (Google Cloud Vision).
# On-demand only (a button) — finds the same item on brand sites / boutiques / other
# marketplaces. Free up to ~1,000/month. console.cloud.google.com → enable "Cloud
# Vision API" → Credentials → API key.
GOOGLE_VISION_API_KEY=

# OPTIONAL — "Find it in shops, with prices" (SerpApi Google Lens). On-demand button;
# free plan ~100 searches/month. Needs UPSTASH_* above set too (to host the photo).
# serpapi.com → API Key.
SERPAPI_KEY=
# Country SerpApi searches shops for (ie = Ireland).
SERPAPI_COUNTRY=ie
